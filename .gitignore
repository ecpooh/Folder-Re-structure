# =============================================================================
# Secret & confidential-file hygiene
# Keeps env files, keys, credentials, and private documents out of git.
# =============================================================================

# --- Environment & local config ---
.env
.env.*
!.env.example
!.env.*.example
.envrc
.flaskenv

# --- Private keys, certificates, keystores ---
*.pem
*.key
*.p12
*.pfx
*.p7b
*.p7c
*.crt
*.cer
*.der
*.jks
*.keystore
*.truststore
id_rsa
id_rsa.*
id_dsa
id_dsa.*
id_ecdsa
id_ecdsa.*
id_ed25519
id_ed25519.*
*.ppk
*.asc
*.gpg
*.kdbx
*.kdb

# --- Credential stores & cloud auth ---
credentials.json
**/credentials.json
service-account*.json
*-service-account.json
*firebase-adminsdk*.json
.aws/
.gcloud/
.gcp/
.azure/
.kube/config
.docker/config.json
.netrc
.npmrc
.pypirc
*.tfvars
*.tfvars.json
terraform.tfstate
terraform.tfstate.*
.terraform/

# --- Common secret / credential filename patterns ---
*secret*
*password*
*passwd*
*credentials*
*apikey*
*api_key*
*access_token*
*auth_token*
*.token

# --- Confidential / personal documents (folder-restructure project) ---
*.pdf
*.docx
*.doc
*.xlsx
*.xls
*.pptx
*.ppt
*.odt
*.ods
*.odp
*.rtf
*.pages
*.numbers
*.keynote
confidential/
private/
secrets/
Personal/
**/confidential/**
**/private/**
**/secrets/**

# --- Local dumps & backups that may contain sensitive data ---
*.sql.gz
*.dump
*.bak
*.backup
*.tmp
*.log

# --- OS noise ---
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp
*.swo
